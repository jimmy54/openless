#!/usr/bin/env bash
# ⚙️ OpenLess macOS 签名配置模板
#
# 用法：
#   cp scripts/macos-signing.env.example scripts/macos-signing.env
#   然后按下面说明填写 scripts/macos-signing.env（该文件已被 .gitignore 忽略，不会提交）
#
# 注意：
#   - 这是 shell 变量文件，会被 `source`。值里有空格必须用引号包住：
#       APPLE_SIGNING_IDENTITY="Developer ID Application: Open Less (ABCDE12345)"
#   - 不要在这个文件里写 Apple ID 登录密码；APPLE_PASSWORD 必须是 App 专用密码。
#   - 填写后用 ./scripts/build-mac-signed.sh --check 自检。

# ── 必需：签名身份 ──────────────────────────────────────────────
# 钥匙串里 Developer ID Application 证书的完整名称（含引号内的团队名和 Team ID）。
# 用这条命令列出可用身份，原样复制引号内的部分：
#   security find-identity -v -p codesigning | grep "Developer ID Application"
APPLE_SIGNING_IDENTITY="Developer ID Application: <Your Name> (<TEAMID>)"

# ── 必需：公证凭据（Apple ID 方式）────────────────────────────────
# 你的 Apple ID 邮箱（必须是证书所属团队的成员）
APPLE_ID="<you@example.com>"

# App 专用密码，形如 abcd-efgh-ijkl-mnop（不是登录密码）
# 生成入口：https://appleid.apple.com → 登录与安全 → App 专用密码
APPLE_PASSWORD="<xxxx-xxxx-xxxx-xxxx>"

# 10 位 Team ID，必须与上面证书所属团队一致
# 查询入口：https://developer.apple.com/account → Membership
APPLE_TEAM_ID="<TEAMID>"

# ── 可选：多团队时才需要（provider short name）─────────────────────
# APPLE_PROVIDER_SHORT_NAME=""

# ── 可选：生成 CI Secrets 用（--print-ci-secrets / --push-secrets）──
# 从钥匙串导出的 .p12 绝对路径；用「钥匙串访问 → 我的证书 → 导出…」
APPLE_P12_PATH="$HOME/Downloads/DeveloperID.p12"
# 导出 .p12 时设置的密码（不是 Apple ID 密码）
APPLE_CERTIFICATE_PASSWORD=""

# ── 可选：本地构建行为 ───────────────────────────────────────────
# 1 = 构建完装到 /Applications 并重置 TCC（默认）；0 = 只构建
# 命令行 --install / --no-install 可覆盖这里的设置
INSTALL=0
